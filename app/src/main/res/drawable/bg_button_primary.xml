<?xml version="1.0" encoding="utf-8"?>
<!-- 主按钮背景：浅蓝填充，按下时颜色加深。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="#78BEE0" /><corners android:radius="10dp" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="#BDE8FA" /><corners android:radius="10dp" /><stroke android:width="1dp" android:color="#5CB4DF" /></shape></item>
</selector>
