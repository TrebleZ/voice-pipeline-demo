<?xml version="1.0" encoding="utf-8"?>
<!-- 独立语音链路 Demo：展示唤醒、实时转写、星火回复和 TTS 播报的当前状态。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_launcher_shell"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="18dp"
    tools:context=".MainActivity"
    tools:deviceIds="tv">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/voice_demo_page_title"
            android:textColor="@color/shell_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/voiceDemoStatusBadge"
            android:layout_width="132dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_points_badge"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="STANDBY" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:background="@drawable/bg_home_card"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="20dp">

            <com.zszc.voicepipeline.VoiceWaveView
                android:id="@+id/voiceDemoWave"
                android:layout_width="58dp"
                android:layout_height="58dp" />

            <TextView
                android:id="@+id/voiceDemoTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textColor="@color/shell_text_primary"
                android:textSize="25sp"
                android:textStyle="bold"
                tools:text="等待唤醒" />

            <TextView
                android:id="@+id/voiceDemoDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/shell_text_secondary"
                android:textSize="17sp"
                tools:text="请说“小飞小飞”" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="28dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/voiceDemoStartButton"
                    style="@style/Widget.VoiceDemo.Button"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_primary"
                    android:text="@string/voice_demo_start"
                    android:textColor="@color/button_primary_text" />

                <Button
                    android:id="@+id/voiceDemoSleepButton"
                    style="@style/Widget.VoiceDemo.Button"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_outline"
                    android:text="@string/voice_demo_standby"
                    android:textColor="@color/button_outline_text" />

                <Button
                    android:id="@+id/voiceDemoCloseButton"
                    style="@style/Widget.VoiceDemo.Button"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_outline"
                    android:text="@string/voice_demo_close"
                    android:textColor="@color/button_outline_text" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_demo_transcript_title"
                    android:textColor="@color/notice_cool_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/voiceDemoTranscript"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="4"
                    android:textColor="@color/shell_text_primary"
                    android:textSize="20sp"
                    tools:text="今天天气怎么样" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="14dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_demo_reply_title"
                    android:textColor="@color/notice_warm_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/voiceDemoReply"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="4"
                    android:textColor="@color/shell_text_primary"
                    android:textSize="20sp"
                    tools:text="今天适合出门散步" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
